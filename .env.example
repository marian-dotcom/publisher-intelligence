# EP-026 local production-like runtime — copy to .env and adjust.
# Local-only safe defaults; never commit real secrets.

# Application environment (local keeps COOKIE_SECURE default semantics;
# staging/production REQUIRE COOKIE_SECURE=true — fail-closed).
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Resource limits (docker compose deploy.resources.limits, per service).
# Defaults below implement the SMALL profile (see docs/runbooks/local-runtime.md
# for the full SMALL/MEDIUM/ORACLE-FREE tables and the browser-replica
# multiplication rules).
#
# SMALL totals with BROWSER_WORKER_REPLICAS=1:
#   CPU 0.30+0.25+0.10+0.30+0.70+0.20+0.10 = 1.95 <= 2   RAM ~3.7G <= 4G
#   N=2 adds +0.70c/+1536M  -> 2.65c / ~5.3G  (EXCEEDS SMALL: use MEDIUM)
#   N=3 adds +1.40c/+3072M  -> 3.35c / ~6.8G  (EXCEEDS SMALL: use MEDIUM)
# ---------------------------------------------------------------------------

API_CPU_LIMIT=0.30
API_MEMORY_LIMIT=512M
FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEMORY_LIMIT=384M
SCHEDULER_CPU_LIMIT=0.10
SCHEDULER_MEMORY_LIMIT=192M
WORKER_CPU_LIMIT=0.30
WORKER_MEMORY_LIMIT=320M
BROWSER_WORKER_REPLICAS=1
BROWSER_CPU_LIMIT=0.70
BROWSER_MEMORY_LIMIT=1536M
POSTGRES_CPU_LIMIT=0.20
POSTGRES_MEMORY_LIMIT=512M
MINIO_CPU_LIMIT=0.10
MINIO_MEMORY_LIMIT=256M

# MEDIUM preset (4 CPU / 8 GB), N=3 fits:
#   API_CPU_LIMIT=0.50 API_MEMORY_LIMIT=512M
#   FRONTEND_CPU_LIMIT=0.40 FRONTEND_MEMORY_LIMIT=400M
#   SCHEDULER_CPU_LIMIT=0.20 SCHEDULER_MEMORY_LIMIT=256M
#   WORKER_CPU_LIMIT=0.50 WORKER_MEMORY_LIMIT=512M
#   BROWSER_WORKER_REPLICAS=3 BROWSER_CPU_LIMIT=0.50 BROWSER_MEMORY_LIMIT=1280M
#   POSTGRES_CPU_LIMIT=0.50 POSTGRES_MEMORY_LIMIT=512M
#   MINIO_CPU_LIMIT=0.25 MINIO_MEMORY_LIMIT=320M

# ORACLE-FREE TARGET preset (~2 CPU / 12 GB): identical to SMALL for CPU;
# raise memory headroom only (e.g. BROWSER_MEMORY_LIMIT=2048M,
# POSTGRES_MEMORY_LIMIT=1024M). N=3 exceeds the 2-CPU envelope and will be
# throttled; keep N<=2 inside envelope.

# Controlled-fixture benchmark targets only. NEVER enable for real monitoring.
BROWSER_ALLOW_PRIVATE_NETWORKS=false

# Internal API target used by the frontend same-origin rewrites.
BACKEND_INTERNAL_URL=http://api:8000
