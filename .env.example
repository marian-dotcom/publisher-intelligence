# EP-026 local production-like runtime — copy to .env and adjust.
# Local-only safe defaults; never commit real secrets.

# Application environment (local keeps COOKIE_SECURE default semantics).
ENVIRONMENT=local

# Browser-worker scaling + resource simulation (see docs/runbooks/local-runtime.md).
BROWSER_WORKER_REPLICAS=1
BROWSER_CPU_LIMIT=1.0
BROWSER_MEMORY_LIMIT=1536M
WORKER_CPU_LIMIT=0.5
WORKER_MEMORY_LIMIT=384M

# Controlled-fixture benchmark targets only. NEVER enable for real monitoring.
BROWSER_ALLOW_PRIVATE_NETWORKS=false

# Generic worker resources.
