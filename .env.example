ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://publisher:publisher-local@localhost:5432/publisher_intelligence

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=publisher-intelligence-local
S3_ACCESS_KEY_ID=publisher-local
S3_SECRET_ACCESS_KEY=replace-with-local-only-secret
S3_USE_SSL=false

JOB_POLL_INTERVAL_SECONDS=1.0
JOB_LEASE_SECONDS=30
JOB_RECLAIM_BACKOFF_SECONDS=5

BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_STABILIZATION_MS=1000
BROWSER_OVERALL_TIMEOUT_SECONDS=60
BROWSER_MAX_REQUESTS=500
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=UTC
BROWSER_ALLOW_PRIVATE_NETWORKS=false
BROWSER_SCHEDULE_STAGGER_SECONDS=30
