ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://publisher:publisher-local@localhost:5432/publisher_intelligence

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=publisher-intelligence-local
S3_ACCESS_KEY_ID=publisher-local
S3_SECRET_ACCESS_KEY=replace-with-local-only-secret
S3_USE_SSL=false

JOB_POLL_INTERVAL_SECONDS=1.0
JOB_LEASE_SECONDS=30
JOB_RECLAIM_BACKOFF_SECONDS=5
